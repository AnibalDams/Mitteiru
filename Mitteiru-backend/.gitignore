# Mitteiru-backend (Cloudflare Workers / Bun) - Project .gitignore
# ==========================================

# Dependencies
node_modules/

# Build outputs
.wrangler/
.wrangler-state/
dist/

# Media pesada / con copyright (no versionar)
static/*.mp4
static/*.mkv
static/videos/

# Bun
.bun/

# Environment
.env
.env.*
!.env.example

# Secretos locales / perfiles de navegador / bases de datos
secrets/
*.sqlite
*.sqlite3
json.json

# Vercel
.vercel

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.eslintcache
.pnp.*
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# TypeScript
*.tsbuildinfo

# Coverage
coverage/
.nyc_output/
*.lcov

# Test
.nyc_output/

# Misc
*.tgz
*.tar.gz
.lock-wscript
.lib-cov
.grunt
bower_components
web_modules