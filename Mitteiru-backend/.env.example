# Puerto del backend. Debe coincidir con API_URL del frontend.
PORT=8000

# MongoDB
DATABASE=mongodb+srv://usuario:password@cluster.mongodb.net/?retryWrites=true&w=majority
# Genera uno con: openssl rand -base64 48
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-de-48-bytes

# Secreto para firmar URLs de playback (opcional; si se omite usa SECRET_KEY)
PLAYBACK_TOKEN_SECRET=

# Duración de las sesiones
USER_TOKEN_TTL=12h
ADMIN_TOKEN_TTL=2h

# Proxies de confianza para req.ip (Render/Heroku: 1; local: vacío)
# También acepta CIDRs separados por coma.
TRUST_PROXY=

# Orígenes permitidos por CORS. Vacío = sin CORS (recomendado con el BFF de SvelteKit).
CORS_ORIGINS=

# Entorno lógico: local | staging | production.
# Si falta o es desconocido se asume production (fail-closed).
APP_ENV=local

# Motor de fuentes externas
# Solo se habilita si APP_ENV=local. En producción debe quedar false.
SOURCES_ENABLED=true
# Sidecar Patchright (recomendado para Cloudflare). No exponer a Internet.
SOURCES_BROWSER_URL=http://127.0.0.1:8787
SOURCES_BROWSER_TOKEN=genera-un-token-aleatorio-de-32-caracteres
# Solo para tests locales que usan 127.0.0.1 como fuente.
SOURCES_ALLOW_PRIVATE=false

# Alternativa: FlareSolverr/Byparr compatible con la API /v1
FLARESOLVERR_URL=

# Dominios adicionales permitidos para el transporte HTTP (separados por coma).
# Los dominios base de cada fuente ya están permitidos por defecto.
SOURCES_ALLOWED_HOSTS=
