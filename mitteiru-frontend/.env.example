# URL privada del backend (solo la usa el servidor de SvelteKit).
API_URL=http://127.0.0.1:8000

# Compatibilidad con versiones anteriores (el navegador ya no la usa).
PUBLIC_API_URL=http://127.0.0.1:8000

# Motor de fuentes externas: true solo en local. En producción false.
PUBLIC_SOURCES_ENABLED=true

# Hosts permitidos para el iframe del reproductor (coma).
# Vacío = ningún host externo (deny by default).
# Local: jkanime.net,animeonsen.xyz
# Producción: jkanime.net (legacy); AnimeOnsen se redacta y no se reproduce.
PUBLIC_EMBED_HOSTS=jkanime.net,animeonsen.xyz
